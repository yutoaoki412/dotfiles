# macOS の path_helper 後に Homebrew とユーザーの PATH を揃える。
typeset -U path PATH

if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x /usr/local/bin/brew ]]; then
  eval "$(/usr/local/bin/brew shellenv)"
fi

path=("$HOME/.local/share/mise/shims" "$HOME/.local/bin" "$HOME/go/bin" $path)
export PATH
