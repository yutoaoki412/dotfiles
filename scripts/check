#!/usr/bin/env python3
from pathlib import Path
import json, subprocess, tomllib
def jsonc(text):
    # Remove JSONC comments and trailing commas only outside string literals.
    tokens=[]; i=0
    while i<len(text):
        if text[i]=='"':
            start=i; i+=1
            while i<len(text):
                if ord(text[i])==92: i+=2; continue
                if text[i]=='"': i+=1; break
                i+=1
            tokens.append(text[start:i]);continue
        if text[i:i+2]=='//':
            end=text.find('\n',i); i=len(text) if end<0 else end;continue
        if text[i:i+2]=='/*':
            end=text.find('*/',i+2)
            if end<0:raise ValueError('Unterminated JSONC comment')
            tokens.append(' ');i=end+2;continue
        tokens.append(text[i]);i+=1
    for i,token in enumerate(tokens):
        if token!=',':continue
        j=i+1
        while j<len(tokens) and tokens[j].isspace():j+=1
        if j<len(tokens) and tokens[j] in (']','}'):tokens[i]=''
    return json.loads(''.join(tokens))
root=Path(__file__).resolve().parents[1]
subprocess.run([str(root/'scripts/check-shell')],check=True)
for path in (root/'home').rglob('*.json'):
    jsonc(path.read_text()) if path.parent.name=="zed" else json.loads(path.read_text())
for path in (root/'home').rglob('*.toml'):
    tomllib.loads(path.read_text())
ghostty=Path('/Applications/Ghostty.app/Contents/MacOS/ghostty')
if ghostty.exists():
    subprocess.run([str(ghostty),'+validate-config','--config-file='+str(root/'home/dot_config/ghostty/config.ghostty')],check=True)
assert (root/'.chezmoiroot').read_text().strip()=='home'
print('Public source checks passed.')
